# Copy to local/site.env and supply your own site values. Never store credentials here.
# Shell scripts source this file; Python reads literal KEY=VALUE assignments.
# Environment variables override these values in both loaders. No shell expansions.
# Keep host lists space-separated; regexes must be quoted for shell and Python.
LAB_GPU_HOSTS='gpu-a gpu-b gpu-c'
LAB_AMPERE_HOSTS='gpu-a gpu-b'
LAB_GPU_HOST_REGEX='\bgpu-[abc]\b'
# Optional GPU-local Hugging Face hub cache; unset/empty keeps the shared cache.
# LAB_LOCAL_HF_CACHE=/path/on/local-disk/huggingface/hub
# Prefixes must be absolute directory paths ending in /. Use identical values
# when the CPU server and lab GPU servers mount the repository at the same path.
REMOTE_PATH_LOCAL_PREFIX=/path/on/cpu-server/
REMOTE_PATH_GPU_PREFIX=/path/on/gpu-servers/

# NQSV cluster: SSH alias, account, shared group/project, working tree and bare repo.
NQSV_HOST=nqsv-cluster
NQSV_USER=your-account
NQSV_GROUP=your-project
NQSV_WORK_DIR=/path/to/work/video_creation
NQSV_BARE_REPO=/path/to/git/video_creation.git

# PBS cluster: supply independently even when the directory layout is similar.
PBS_HOST=pbs-cluster
PBS_USER=your-account
PBS_GROUP=your-project
PBS_WORK_DIR=/path/to/work/video_creation
PBS_BARE_REPO=/path/to/git/video_creation.git
